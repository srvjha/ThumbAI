generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  email     String
  fullName  String
  profile_img String?
  clerk_id  String      @unique
  credits   Int         @default(7)
  plan      PLAN        @default(FREE)
  role      Role        @default(USER)
  last_active_at DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Thumbnail Thumbnail[]
  Order     Order[]
}

model Thumbnail {
  id                   String   @id @default(uuid())
  user_id              String
  request_id           String   @unique
  user_prompt          String   @default("")
  enhanced_ai_prompt   String   @default("")
  num_of_images        Int?
  status               String[]
  image_url            String[]
  content_type         String?
  aspect_ratio         String?
  model_used           MODEL?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [user_id], references: [id])
}

enum MODEL {
  TEXT_TO_IMAGE
  IMAGE_TO_IMAGE
  URL_TO_IMAGE
}

model Order {
  id                String      @id @default(uuid())
  // Nullable only for orders predating this column; every new order sets it.
  user_id           String?
  productId         String
  productName       String?
  amount            Int?
  // Credits this purchase grants, resolved from the server-side plan
  // catalogue at creation time so the amount can never be set by a client.
  credits           Int         @default(0)
  // Set once the webhook has topped up the buyer. Razorpay retries
  // deliveries, so the grant is guarded on this rather than on status.
  credits_granted   Boolean     @default(false)
  currency          String      @default("INR")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            OrderStatus @default(created)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User?       @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

enum PLAN {
  FREE
  PAID
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  created
  pending
  paid
  failed
  cancelled
  refunded
}
