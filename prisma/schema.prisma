generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String
  fullName            String
  profile_img         String?
  clerk_id            String               @unique
  // A cache of SUM(CreditTransaction.amount), updated in the same
  // transaction as every ledger row. Never write it any other way.
  credits             Int                  @default(0)
  plan                PLAN                 @default(FREE)
  role                Role                 @default(USER)
  last_active_at      DateTime
  // Set when the Clerk account is deleted. The row stays so orders and the
  // credit ledger keep their owner; personal fields are cleared.
  deleted_at          DateTime?
  // When the free signup credits were decided, granted or refused. Null
  // until the user's first authenticated request.
  signup_checked_at   DateTime?
  // Set by an admin. A suspended user can sign in but every API refuses
  // them until it is cleared.
  suspended_at        DateTime?
  suspended_reason    String?
  // First touch: copied from the first browser that signed in as this user.
  country             String?
  region              String?
  city                String?
  /// Referrer domain or utm_source of that first visit; 'direct' for none.
  acquisition_source  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  Thumbnail           Thumbnail[]
  Order               Order[]
  CreditTransaction   CreditTransaction[]
  SignupCreditAttempt SignupCreditAttempt?
  Visitor             Visitor[]
  PromptFlag          PromptFlag[]
  AdminActionsTaken   AdminAction[]        @relation("AdminActionActor")
  AdminActionsOn      AdminAction[]        @relation("AdminActionTarget")

  @@index([createdAt])
}

model Thumbnail {
  id                 String     @id @default(uuid())
  user_id            String
  // Null until Fal accepts the job: the row is created first so the credit
  // charge has something to belong to.
  request_id         String?    @unique
  user_prompt        String     @default("")
  enhanced_ai_prompt String     @default("")
  num_of_images      Int?
  // Single value, not a list. This used to be String[] that callers *pushed*
  // onto, so rows accumulated ['PENDING','COMPLETED'] while readers indexed
  // [0] and saw the stale value.
  status             GEN_STATUS @default(PENDING)
  image_url          String[]
  content_type       String?
  aspect_ratio       String?
  model_used         MODEL?
  // The Fal endpoint that served this request. The webhook needs it to poll
  // the right queue; it previously hardcoded the image-to-image endpoint for
  // every workflow.
  model_endpoint     String?
  model_tier         TIER?
  // The seed actually sent, when the endpoint honours one. Recorded so a
  // generation can be reproduced or re-rolled as a deliberate variation.
  seed               Int?
  /// Why it failed, when it did: the provider's error or our own.
  error              String?
  /// When the images landed. With createdAt, the end-to-end latency.
  completed_at       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user              User                @relation(fields: [user_id], references: [id])
  CreditTransaction CreditTransaction[]
  GenerationEvent   GenerationEvent[]
  PromptFlag        PromptFlag[]

  // The library, detail, analytics and stale-sweep queries all filter by
  // user and order or range by time.
  @@index([user_id, createdAt])
  @@index([createdAt])
}

/// Every step of a generation, in order: the admin log. Written best-effort;
/// a failed write never fails the generation.
model GenerationEvent {
  id           String    @id @default(uuid())
  thumbnail_id String
  type         GEN_EVENT
  detail       Json?
  createdAt    DateTime  @default(now())

  thumbnail Thumbnail @relation(fields: [thumbnail_id], references: [id], onDelete: Cascade)

  @@index([thumbnail_id, createdAt])
}

enum GEN_EVENT {
  CREATED
  CHARGED
  SUBMITTED
  SUBMIT_FAILED
  IN_PROGRESS
  WEBHOOK_RECEIVED
  COMPLETED
  FAILED
  REFUNDED
}

enum MODEL {
  TEXT_TO_IMAGE
  IMAGE_TO_IMAGE
  URL_TO_IMAGE
}

enum TIER {
  DRAFT
  QUALITY
}

enum GEN_STATUS {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Order {
  id                String      @id @default(uuid())
  // Nullable only for orders predating this column; every new order sets it.
  user_id           String?
  productId         String
  productName       String?
  amount            Int?
  // Credits this purchase grants, resolved from the server-side plan
  // catalogue at creation time so the amount can never be set by a client.
  credits           Int         @default(0)
  currency          String      @default("INR")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            OrderStatus @default(created)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User?               @relation(fields: [user_id], references: [id])
  CreditTransaction CreditTransaction[]

  @@index([user_id])
}

/// Every change to a user's credit balance. User.credits is the running sum.
model CreditTransaction {
  id            String         @id @default(uuid())
  user_id       String
  type          CREDIT_TX_TYPE
  /// Signed: positive adds credits, negative removes them.
  amount        Int
  /// The user's balance immediately after this row was applied.
  balance_after Int
  order_id      String?
  thumbnail_id  String?
  note          String?
  createdAt     DateTime       @default(now())

  user      User       @relation(fields: [user_id], references: [id])
  order     Order?     @relation(fields: [order_id], references: [id])
  thumbnail Thumbnail? @relation(fields: [thumbnail_id], references: [id])

  // At most one of each kind per order or generation. A redelivered webhook
  // or a second refund path fails the insert instead of moving the balance.
  @@unique([type, order_id])
  @@unique([type, thumbnail_id])
  @@index([user_id, createdAt])
}

enum CREDIT_TX_TYPE {
  OPENING_BALANCE
  SIGNUP_GRANT
  PURCHASE
  GENERATION_CHARGE
  GENERATION_REFUND
  ORDER_REFUND_CLAWBACK
  ADMIN_ADJUSTMENT
}

enum PLAN {
  FREE
  PAID
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  created
  pending
  paid
  failed
  cancelled
  refunded
}

/// Fixed-window request counters shared by every server instance: per-user
/// rate limits, and "at most once per window" housekeeping throttles.
/// Rows are pruned once expired; see src/server/rateLimit.ts.
model RateLimitCounter {
  key          String
  window_start DateTime
  count        Int      @default(0)
  expires_at   DateTime

  @@id([key, window_start])
  @@index([expires_at])
}

/// One decision per user on the free signup credits, granted or refused,
/// with the signals it was made on. Doubles as the log for judging abuse.
model SignupCreditAttempt {
  id               String   @id @default(uuid())
  user_id          String   @unique
  /// Lowercased, +tag stripped, Gmail dots removed. Survives soft delete.
  email_normalized String
  email_domain     String
  /// HMAC of the client IP (IPv6 grouped by /64) under SIGNUP_IP_SALT.
  ip_hash          String?
  granted          Boolean
  /// Why it was refused: disposable_email, email_reused or ip_limit.
  reason           String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([email_normalized])
  @@index([ip_hash, createdAt])
}

/// A browser, identified by a first-party cookie: in effect one device of
/// one person. Raw IPs are never stored; location comes from Vercel's geo
/// headers.
model Visitor {
  id              String   @id
  user_id         String?
  first_seen_at   DateTime @default(now())
  last_seen_at    DateTime @default(now())
  country         String?
  region          String?
  city            String?
  referrer_domain String?
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  landing_path    String?
  /// desktop, mobile or tablet.
  device          String
  browser         String?
  os              String?
  pageviews       Int      @default(0)

  user     User?      @relation(fields: [user_id], references: [id])
  PageView PageView[]

  @@index([user_id])
  @@index([first_seen_at])
}

model PageView {
  id         String   @id @default(uuid())
  visitor_id String
  user_id    String?
  path       String
  createdAt  DateTime @default(now())

  visitor Visitor @relation(fields: [visitor_id], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// A prompt that tripped moderation or the injection check. The prompt text
/// is deliberately not copied here: admins see what kind of problem it was,
/// never what the user wrote.
model PromptFlag {
  id           String        @id @default(uuid())
  user_id      String
  /// The generation it belonged to, when one was created.
  thumbnail_id String?
  source       FLAG_SOURCE
  categories   String[]
  /// Highest moderation score, 0 to 1. Null for the injection check.
  score        Float?
  severity     FLAG_SEVERITY
  resolved_at  DateTime?
  resolved_by  String?
  createdAt    DateTime      @default(now())

  user      User       @relation(fields: [user_id], references: [id])
  thumbnail Thumbnail? @relation(fields: [thumbnail_id], references: [id], onDelete: SetNull)

  @@index([user_id, resolved_at])
  @@index([createdAt])
}

enum FLAG_SOURCE {
  MODERATION
  INJECTION
}

enum FLAG_SEVERITY {
  LOW
  MEDIUM
  HIGH
}

/// What admins did, to whom, and why.
model AdminAction {
  id             String       @id @default(uuid())
  admin_id       String
  target_user_id String?
  action         ADMIN_ACTION
  detail         Json?
  createdAt      DateTime     @default(now())

  admin  User  @relation("AdminActionActor", fields: [admin_id], references: [id])
  target User? @relation("AdminActionTarget", fields: [target_user_id], references: [id])

  @@index([createdAt])
  @@index([target_user_id, createdAt])
}

enum ADMIN_ACTION {
  SUSPEND
  UNSUSPEND
  RESET_FLAGS
  ADJUST_CREDITS
}
