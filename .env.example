# ---- Database ----
# LOCAL development. `pnpm db:up` starts this via docker compose.
# Production must NOT live in this file — see .env.prod below.
DATABASE_URL="postgresql://thumbai:thumbai@localhost:5433/thumbai"

# ---- Clerk (auth) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Signing secret for the /api/webhook/register endpoint
NEXT_CLERK_WEBHOOK_SECRET="whsec_..."

# ---- Fal (image generation) ----
# Server-side only. There is deliberately no NEXT_PUBLIC_ variant: that would
# inline the key into the browser bundle, where anyone could read and spend it.
FAL_KEY="..."
# Public origin Fal should call back on. In development use a tunnel origin,
# e.g. https://your-subdomain.ngrok-free.app
NEXT_PUBLIC_FAL_WEBHOOK_URL="https://example.com"

# ---- OpenAI (prompt authoring) ----
OPENAI_API_KEY="sk-..."
# Optional: a Slack or Discord webhook that hears about blocked requests at once.
ADMIN_ALERT_WEBHOOK_URL=""
# Optional. Overrides PROMPT_MODEL in src/config/models.ts
# OPENAI_PROMPT_MODEL="gpt-4.1"

# ---- Dodo Payments (checkout, USD) ----
# Dashboard → Developer → API keys. Test and live mode keys differ.
DODO_PAYMENTS_API_KEY="..."
# test_mode or live_mode; must match the key above.
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Dashboard → Developer → Webhooks, endpoint <site>/api/webhook/payment,
# events payment.succeeded, payment.failed, payment.cancelled.
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
# Printed by: node --env-file=.env tools/dodo-create-products.mjs
DODO_PRODUCT_CREATOR_PRO="pdt_..."
DODO_PRODUCT_BUSINESS_ELITE="pdt_..."

# ---- Other ----
AI_GATEWAY_API_KEY="..."
GEMINI_API_KEY="..."
# Used for metadataBase / Open Graph URLs
# NEXT_PUBLIC_SITE_URL="https://thumbai.app"

# ---- Abuse protection (optional locally, set in production) ----
# Secret (16+ chars) for hashing signup IPs. Unset = no per-IP signup limit.
# Generate: openssl rand -hex 32
# SIGNUP_IP_SALT="..."

# ---- Production database: use a separate .env.prod ----
# Create a .env.prod holding ONLY the production DATABASE_URL. It is not a
# Next.js env-file convention, so it is never loaded automatically —
# deliberately, so `next dev` cannot reach production.
#
#   DATABASE_URL="postgresql://...neon.tech/neondb?sslmode=require"
#
# Use it explicitly:
#   pnpm db:status:prod
#   pnpm db:deploy:prod
#   pnpm db:backup:prod
#   node --env-file=.env.prod tools/grant-admin.mjs
